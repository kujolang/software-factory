# Application-owned adapter; imports the pinned sibling Dispatch, not a copied engine.
# Run from DISPATCH_ROOT with FACTORY_ROOT and FACTORY_RUN_DIR absolute paths.
from src.core.step import create_step
from src.core.state import create_run_state, load_run_state
from src.core.runner import run_workflow, run_workflow_with_admission
from src.core.plugins import create_plugin, apply_plugin_to_runtime
from src.core.utils import dict_get_or
from src.tools.tool import create_tool_registry, create_tool
from src.workflows.workflow import create_workflow

func factory_id_valid(value) {
    if type(value) != "string" || len(value) == 0 || len(value) > 80 { return false }
    for character in split(value, "") {
        if contains("abcdefghijklmnopqrstuvwxyz0123456789-_", character) == 0 { return false }
    }
    return true
}

func factory_worker(input, context) {
    run_dir := env("FACTORY_RUN_DIR")
    factory_root := env("FACTORY_ROOT")
    timeout_ms := context["execution_timeout_ms"]
    if timeout_ms <= 0 { timeout_ms = 900000 }
    # A fixed executable and argv boundary. Workers own validation, isolated
    # candidate writes, provider usage, corrections, and release policy.
    kind := env_or("FACTORY_WORKFLOW_KIND", "application")
    assert(kind == "application" || kind == "specification" || kind == "documentation" || kind == "cli-construction", "Unknown trusted factory workflow kind")
    worker := "/factory/worker.mjs"
    if kind == "specification" { worker = "/factory/spec-pipeline-worker.mjs" }
    if kind == "documentation" { worker = "/factory/documentation-pipeline-worker.mjs" }
    if kind == "cli-construction" { worker = "/factory/cli-mission-worker.mjs" }
    result := spawn_process([env_or("NODE_BIN", "node"), factory_root + worker, run_dir, context["step_id"]], {"cwd": factory_root, "inherit_env": true, "timeout_ms": timeout_ms, "max_output_bytes": 1048576})
    if result.success == false {
        return {"ok": false, "error": {"code": "factory_worker_failed", "message": "Worker failed or exceeded its bound; inspect the task evidence: " + context["step_id"], "retryable": false}}
    }
    try {
        envelope := parse_json(trim(result.stdout))
        if type(envelope) != "dict" || dict_get_or(envelope, "ok", false) != true || type(dict_get_or(envelope, "data", null)) != "dict" {
            return {"ok": false, "error": {"code": "factory_worker_contract", "message": "Worker did not return an ok/data object", "retryable": false}}
        }
        return envelope
    } except err {
        return {"ok": false, "error": {"code": "factory_worker_contract", "message": "Worker stdout was not one JSON envelope", "retryable": false}}
    }
}

run_dir := env("FACTORY_RUN_DIR")
assert(run_dir != "", "FACTORY_RUN_DIR is required")
assert(env("FACTORY_ROOT") != "", "FACTORY_ROOT is required")
definition := parse_json(read_file(run_dir + "/workflow.json"))
assert(type(definition["tasks"]) == "array" && len(definition["tasks"]) > 0 && len(definition["tasks"]) <= 32, "Workflow requires 1–32 tasks")
steps := []
seen := {}
for task in definition["tasks"] {
    task_id := task["id"]
    assert(factory_id_valid(task_id), "Task ID must use lowercase letters, digits, hyphen, underscore")
    assert(has_key(seen, task_id) == 0, "Duplicate task ID")
    dependencies := dict_get_or(task, "dependsOn", [])
    assert(type(dependencies) == "array", "dependsOn must be an array")
    for dependency in dependencies { assert(has_key(seen, dependency), "Dependencies must name earlier tasks") }
    seen[task_id] := true
    timeout_ms := dict_get_or(task, "timeoutMs", 900000)
    assert(type(timeout_ms) == "int" && timeout_ms >= 1000 && timeout_ms <= 3600000, "Task timeout must be 1000–3600000 ms")
    parallel := dict_get_or(task, "parallelSafe", false)
    assert(type(parallel) == "bool", "parallelSafe must be boolean")
    steps := push(steps, create_step(task_id, dict_get_or(task, "name", task_id), "tool", {"agent_id": dict_get_or(task, "agentId", ""), "tool_name": "factory_worker", "depends_on": dependencies, "output_key": task_id, "parallel_safe": parallel, "idempotency_key": task_id, "timeout_ms": timeout_ms, "effect_class": "local_reversible", "input_schema": {"type": "dict"}, "output_schema": {"type": "dict"}}))
}
workflow := create_workflow({"id": dict_get_or(definition, "id", "software-factory"), "name": dict_get_or(definition, "name", "Kujo Software Factory"), "description": "Role-scoped worker execution; release authority remains the independent candidate gate", "input_schema": {"type": "dict"}, "output_schema": {"type": "dict"}, "agents": {}, "tools": [], "steps": steps, "max_parallel_steps": 2, "memory_config": {}, "default_retry_policy": {"max_attempts": 1}, "approval_config": {"auto_approve": false}})
worker_tool := create_tool("factory_worker", "Bounded local role worker", {"type": "dict"}, {"type": "dict"}, factory_worker, null)
# Reviewed bounded handler: exactly one spawn_process with deadline/output caps,
# followed by bounded JSON parsing. This is not a generic shell tool.
worker_tool["__dispatch_deadline_bounded"] := true
installed := apply_plugin_to_runtime(workflow, create_tool_registry(), create_plugin("kujo-software-factory", {}, {}, [worker_tool]))
workflow = installed["workflow"]
pause_before := env_or("FACTORY_PAUSE_BEFORE", "")
assert(pause_before == "" || has_key(seen, pause_before), "Operator pause must name a declared task")
assert(pause_before == "" || env_or("FACTORY_RESUME_ID", "") == "", "Recovery cannot inherit a checkpoint interruption request")
options := {"auto_approve": false, "interactive": false, "event_hook": func(event) {
    append_file(run_dir + "/dispatch-events.jsonl", to_json(event) + "\n")
    if pause_before != "" && event["event_type"] == "step_started" && event["step_id"] == pause_before {
        # Native hook precedes step persistence/execution. Fixed bounded operator
        # interruption window; no approval or generic executable authority.
        paused := spawn_process([env_or("NODE_BIN", "node"), env("FACTORY_ROOT") + "/scripts/pause-factory-checkpoint.mjs", run_dir, pause_before], {"cwd": env("FACTORY_ROOT"), "inherit_env": true, "timeout_ms": 61000, "max_output_bytes": 65536})
        assert(false, "Operator checkpoint window ended; continuation prohibited")
    }
}}
resume_id := env_or("FACTORY_RESUME_ID", "")
result := {}
summary_path := run_dir + "/dispatch-result.json"
if resume_id == "" {
    state := create_run_state(workflow, {"topic": dict_get_or(definition, "name", "Software factory mission"), "factory_run_dir": run_dir}, run_dir + "/dispatch", {"auto_approve": false, "interactive": false})
    result = run_workflow(workflow, state, installed["tool_registry"], options)
} else {
    assert(factory_id_valid(resume_id), "Invalid native resume identity")
    loaded := load_run_state(run_dir + "/dispatch", resume_id)
    assert(loaded["ok"], "Original native state unavailable")
    attempt := env("FACTORY_RECOVERY_ATTEMPT")
    assert(starts_with(attempt, run_dir + "/artifacts/recovery-attempts/attempt-") && contains(attempt, "..") == 0, "Recovery attempt path rejected")
    admission := func(current) {
        checked := spawn_process([env_or("NODE_BIN", "node"), env("FACTORY_ROOT") + "/factory/operations.mjs", "admit-resume", run_dir, attempt], {"cwd": env("FACTORY_ROOT"), "inherit_env": true, "timeout_ms": 60000, "max_output_bytes": 65536})
        if checked.success == false {return {"ok":false,"error":{"code":"factory_resume_denied","message":"Exact recovery admission rejected; original evidence retained","retryable":false}}}
        receipt := parse_json(trim(checked.stdout))
        if receipt["ok"] != true || receipt["nativeId"] != current["run_id"] || receipt["nativeRevision"] != dict_get_or(current, "revision", null) {return {"ok":false,"error":{"code":"factory_resume_state_changed","message":"Native revision changed","retryable":false}}}
        return {"ok":true,"run_state":current}
    }
    result = run_workflow_with_admission(workflow, loaded["run_state"], installed["tool_registry"], options, admission)
    summary_path = attempt + "/dispatch-result.json"
}
release_authority := "independent-candidate-gate"
if env_or("FACTORY_WORKFLOW_KIND", "application") == "specification" { release_authority = "none-specification-review-only" }
if env_or("FACTORY_WORKFLOW_KIND", "application") == "documentation" { release_authority = "none-documentation-review-only" }
if env_or("FACTORY_WORKFLOW_KIND", "application") == "cli-construction" { release_authority = "independent-cli-candidate-gate" }
summary := {"schema": "kujo.factory.dispatch-result/v1", "ok": result["ok"], "status": result["run_state"]["status"], "runId": result["run_state"]["run_id"], "runDir": result["run_state"]["run_dir"], "releaseAuthority": release_authority}
write_file(summary_path, to_json(summary))
print(to_json(summary))
assert(result["ok"] && result["run_state"]["status"] == "completed", "Factory workflow failed; release remains blocked")
