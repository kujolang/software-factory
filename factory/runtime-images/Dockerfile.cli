ARG FACTORY_BASE=kujolang/factory-node:local
FROM python:3.13.9-slim-bookworm@sha256:b685a4fa58bb19d1814d78a1ec0f0208f351452724f78b20212c984d6e124a34 AS python
FROM ${FACTORY_BASE}
COPY --from=python /usr/local /opt/python
ENV LD_LIBRARY_PATH=/opt/python/lib
RUN /opt/python/bin/python3 --version && /opt/lens-runtime/node_modules/.bin/kujo --version && chmod -R a-w /opt/python
