ARG FACTORY_BASE=kujolang/factory-node:local
FROM ${FACTORY_BASE} AS base
FROM rust:slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37
COPY --from=base /usr/local/bin/node /usr/local/bin/node
COPY --from=base /opt/factory/*.mjs /opt/factory/
RUN node --version && rustc --version && mkdir -p /workspace/private/input && chmod 700 /workspace/private
WORKDIR /workspace
