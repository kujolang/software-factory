ARG FACTORY_BASE=kujolang/factory-node:local
FROM golang:bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS go
FROM ${FACTORY_BASE}
COPY --from=go /usr/local/go /opt/go
COPY typescript-runtime-package-lock.json /opt/typescript/package-lock.json
RUN cd /opt/typescript && node -e "const p=require('./package-lock.json').packages[''];require('fs').writeFileSync('package.json',JSON.stringify(p))" && npm ci --ignore-scripts --no-audit --no-fund && node_modules/.bin/tsc --version && /opt/go/bin/go version && chmod -R a-w /opt/go /opt/typescript
